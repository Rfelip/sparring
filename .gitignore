# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# ── OS / editor cruft ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/

# ── Per-user runtime data (lives in the OS data dir, never in-repo) ──────
# Linux ~/.local/share/sparring, Win %APPDATA%/sparring, mac ~/Library/...
# (kept here for clarity — these paths are outside the repo anyway)

# ── Tauri build artifacts ───────────────────────────────────────────────
packaging/tauri/target/
packaging/tauri/**/gen/
**/gen/schemas/
**/target/

# ── Distributable bundles (regenerated by `make build`; too big to track) ─
dist/

# ── Scratch / build logs written during a packaging run ─────────────────
.buildlog.tmp
.smoke.log
.ldmanual.log
.probe_result.txt
.artstatus.txt

# NOTE on web/decks/*.json:
#   These are COMMITTED on purpose. They are generated by tools/build.py from
#   cards/**/*.yaml, but committing them means a fresh clone runs without a build
#   step, and the app rebuilds them on launch if they're ever missing
#   (ensure_decks_built() in app/sparring_app.py). Do NOT ignore them.

# Keep the vendored KaTeX (web/vendor/katex/) — it is intentionally committed
# so the app works fully offline. Do NOT ignore it.
